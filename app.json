{
  "expo": {
    "name": "BEANFOLD",
    "slug": "beanfold",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "beanfold",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.beanfold.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "원두 라벨을 촬영해 등록할 수 있어요. 촬영 없이도 수동 등록이 가능합니다.",
        "NSPhotoLibraryUsageDescription": "원두 패키지 사진을 선택해 기록할 수 있어요. 사진 없이도 사용할 수 있습니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#211B18"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "package": "app.beanfold.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "원두 패키지 사진을 선택해 기록할 수 있어요. 사진 없이도 사용할 수 있습니다.",
          "cameraPermission": "원두 라벨을 촬영해 등록할 수 있어요. 촬영 없이도 수동 등록이 가능합니다."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "원두 라벨을 촬영해 등록할 수 있어요. 촬영 없이도 수동 등록이 가능합니다."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3B2E26"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/app-icon-reference.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F6F2EB"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/beadfold"
    }
  }
}
